{
  "name": "nextcloud-vector-view",
  "version": "1.0.0",
  "description": "A lean native desktop wrapper for a self-hosted Nextcloud Hub (Files, Mail, Calendar, Talk, Contacts, Dashboard).",
  "author": {
    "name": "Nextcloud Vector View"
  },
  "homepage": "https://nextcloud.com",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "generate-icons": "node scripts/generate-icons.js",
    "predist": "node scripts/generate-icons.js",
    "dist": "electron-builder --linux deb AppImage",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nextcloudvectorview.app",
    "productName": "Nextcloud Vector View",
    "copyright": "Copyright © 2026",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-build",
      "buildResources": "build"
    },
    "linux": {
      "executableName": "nextcloud-vector-view",
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "synopsis": "Native desktop wrapper for your self-hosted Nextcloud Hub",
      "description": "Use Files, Mail, Calendar, Talk, Contacts and the Dashboard of your self-hosted Nextcloud server in a dedicated desktop window with a quick-jump sidebar, system tray and native notifications.",
      "maintainer": "Nextcloud Vector View <noreply@example.com>",
      "desktop": {
        "Name": "Nextcloud Vector View",
        "GenericName": "Nextcloud Client",
        "Comment": "Access your self-hosted Nextcloud Hub",
        "Categories": "Network;Internet;Utility;",
        "Keywords": "nextcloud;cloud;files;mail;calendar;talk;contacts;vector;",
        "StartupWMClass": "Nextcloud-vector-view"
      }
    },
    "deb": {
      "priority": "optional",
      "afterInstall": null
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
